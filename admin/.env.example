# ── KrushiSarva Admin SPA env ────────────────────────────────────────────────────

# Base URL of the backend admin API. The client calls `${VITE_API_URL}/admin/*`
# and `${VITE_API_URL}/auth/*`. Default '/api/v1' uses the Vite dev proxy (below)
# / same-origin reverse proxy in prod, which keeps cookies first-party and CSRF
# simple. Set to an absolute origin (e.g. https://api.cropsetu.app/api/v1) only if
# the admin app is served from a DIFFERENT origin than the API — then that admin
# origin MUST also be added to the backend's ALLOWED_ORIGINS.
VITE_API_URL=/api/v1

# Dev-only: where `vite dev` proxies /api to (your running backend).
# 3001 matches backend/.env.example PORT — copying 3000 here gives ECONNREFUSED
# (or, worse, proxies to whatever unrelated app is on 3000) on every request.
VITE_API_PROXY=http://localhost:3001

# Shown in the top-bar environment badge (e.g. local | staging | production).
VITE_ENV_NAME=local

# ── Firebase phone login (required in production) ──────────────────────────────
# Firebase WEB app config (Firebase console → Project settings → Your apps → Web
# app → SDK setup and configuration → Config). These values are PUBLIC, not
# secrets. Set all four required ones and the login screen uses Firebase phone
# auth (Google sends the SMS); leave any of them empty and it uses the dev OTP
# flow, which works only against a development backend. The app must be in the
# SAME Firebase project as the backend's FIREBASE_PROJECT_ID. See README.md "Firebase phone login".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional, unused by phone auth; accepted so the console snippet can be pasted whole.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
