{
  "expo": {
    "name": "KrushiSarva Seller",
    "slug": "krushisarva-seller",
    "scheme": "krushisarva-seller",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c9c3335e-0727-4fba-a3eb-dd10f653b50c",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.krushisarva.seller",
      "infoPlist": {
        "NSCameraUsageDescription": "KrushiSarva Seller needs camera access to photograph the products you list.",
        "NSPhotoLibraryUsageDescription": "KrushiSarva Seller needs photo library access to upload product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "package": "com.krushisarva.seller",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "com.google.android.gms.permission.AD_ID"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "KrushiSarva Seller needs photo library access to upload product images.",
          "cameraPermission": "KrushiSarva Seller needs camera access to photograph the products you list.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "owner": "krushisarva",
    "extra": {
      "eas": {
        "projectId": "c9c3335e-0727-4fba-a3eb-dd10f653b50c"
      }
    }
  }
}
